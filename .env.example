# Server-only provider key. Never place this value in game.js or index.html.
HELIUS_API_KEY=replace_with_your_helius_api_key

# Production leaderboard database (Neon, Supabase, Railway, Render, etc.).
# Without this, Node 22+ uses data/bonkler.sqlite for durable local development.
# DATABASE_URL=postgresql://user:password@host:5432/bonkler
# Set to "require" only when your provider requires TLS without a local CA bundle.
# DATABASE_SSL=require

# Optional deployment port and local SQLite override.
PORT=3001
# SQLITE_PATH=./data/bonkler.sqlite
